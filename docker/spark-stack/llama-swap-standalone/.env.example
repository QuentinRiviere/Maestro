# Copy to .env (git ignores it) and fill in.
SPARK_BIND_ADDR=100.x.y.z          # tailscale ip -4 (127.0.0.1 when unset; never 0.0.0.0)
LLAMA_SWAP_PORT=8080
MODEL_HUB_PORT=8090
MODELS_DIR=/home/qriv/models       # GGUF files; must be writable by UID_GID
UID_GID=1000:1000                  # id -u / id -g of the owner of MODELS_DIR and ./config
LLAMA_SWAP_API_KEY=                # printf "sk-%s\n" "$(openssl rand -hex 24)"
MODEL_HUB_TOKEN=                   # openssl rand -hex 24 (login token of the hub UI)
HF_TOKEN=                          # optional, read-only Hugging Face token (gated repos, rate limits)
# Optional:
# MODEL_HUB_MEMORY_GB=128          # unified memory budget for the fit badges
# MODEL_HUB_RESERVED_GB=10         # OS, Docker, llama-swap
# MODEL_HUB_DEFAULT_GROUP=on-demand
# MODEL_HUB_TRUSTED_AUTHORS=ggml-org,unsloth,bartowski,Qwen,huihui-ai,google,openai,mistralai,microsoft,nvidia,lmstudio-community,meta-llama
