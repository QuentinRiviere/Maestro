{
    "model": {
        "name": "Nano Banana (fal.ai)",
        "architecture": "cloud_image",
        "description": "Google Gemini 2.5 Flash Image on fal.ai: text-to-image and multi-image editing. About $0.04 per image.",
        "cloud": {
            "provider": "fal",
            "endpoint": "fal-ai/nano-banana",
            "edit_endpoint": "fal-ai/nano-banana/edit",
            "image_field": "image_urls",
            "image_list": true,
            "max_images_in": 10,
            "size": "aspect_ratio",
            "aspect_ratios": [
                "21:9",
                "16:9",
                "3:2",
                "4:3",
                "5:4",
                "1:1",
                "4:5",
                "3:4",
                "2:3",
                "9:16"
            ],
            "count_field": "num_images",
            "max_count": 4,
            "input": {
                "output_format": "png"
            }
        }
    },
    "resolution": "1024x1024",
    "batch_size": 1
}
