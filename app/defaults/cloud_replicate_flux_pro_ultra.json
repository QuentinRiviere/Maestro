{
    "model": {
        "name": "FLUX1.1 Pro Ultra (Replicate)",
        "architecture": "cloud_image",
        "description": "Black Forest Labs FLUX1.1 [pro] ultra on Replicate: photoreal text-to-image up to 4 MP. About $0.06 per image.",
        "cloud": {
            "provider": "replicate",
            "endpoint": "black-forest-labs/flux-1.1-pro-ultra",
            "size": "aspect_ratio",
